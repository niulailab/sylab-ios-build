{
  "expo": {
    "name": "sylab",
    "slug": "sylab-app",
    "version": "1.0.34",
    "orientation": "portrait",
    "scheme": "sylab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sylab.app",
      "infoPlist": {
        "NSCameraUsageDescription": "\u5141\u8bb8\u8bbf\u95ee\u76f8\u673a\u4ee5\u62cd\u6444\u7167\u7247",
        "NSPhotoLibraryUsageDescription": "\u5141\u8bb8\u8bbf\u95ee\u7167\u7247\u4ee5\u4e0a\u4f20\u6587\u4ef6",
        "NSMicrophoneUsageDescription": "\u5141\u8bb8\u4f7f\u7528\u9ea6\u514b\u98ce\u8fdb\u884c\u8bed\u97f3\u8f93\u5165",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      },
      "buildNumber": "34"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6030ff"
      },
      "package": "com.sylab.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 31
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "\u5141\u8bb8\u8bbf\u95ee\u7167\u7247\u4ee5\u4e0a\u4f20\u6587\u4ef6",
          "cameraPermission": "\u5141\u8bb8\u62cd\u6444\u7167\u7247"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d96bf15e-fb28-4efa-bad6-3449a5f8e0b7"
      },
      "router": {
        "origin": false
      },
      "EXPO_PUBLIC_API_BASE": "https://direct.symsgf.xyz:8099",
      "EXPO_PUBLIC_OPEN_API_BASE": "https://direct.symsgf.xyz:8099",
      "EXPO_PUBLIC_ENABLE_API_LOG": "true"
    },
    "owner": "ahuaj",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d96bf15e-fb28-4efa-bad6-3449a5f8e0b7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}